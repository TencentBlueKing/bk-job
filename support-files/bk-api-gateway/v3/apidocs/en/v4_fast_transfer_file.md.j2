### Request Parameters Example

- POST

```json
{
    "bk_scope_type": "biz",
    "bk_scope_id": "2",
    "task_name": "push-config",
    "file_source_list": [
        {
            "file_list": [
                "/tmp/REGEX:[a-z]*.txt"
            ],
            "file_type": 1,
            "account_alias": "root",
            "execute_target": {
                "host_list": [
                    {
                        "bk_host_id": 10001
                    },
                    {
                        "bk_cloud_id": 0,
                        "ip": "127.0.0.1"
                    }
                ]
            }
        },
        {
            "file_list": [
                "testbucket/test.txt"
            ],
            "file_type": 3,
            "file_source_id": 1
        },
        {
            "file_list": [
                "testbucket/test2.txt"
            ],
            "file_type": 3,
            "file_source_code": "testInnerCOS"
        }
    ],
    "file_target_path": "/data/release/",
    "file_target_name": "app.conf",
    "account_id": 1000,
    "execute_target": {
        "host_list": [
            {
                "bk_cloud_id": 0,
                "ip": "127.0.0.2"
            }
        ],
        "dynamic_group_list": [
            {
                "id": "asdo8gojhasdfskft7pr5"
            }
        ],
        "topo_node_list": [
            {
                "id": 1000,
                "node_type": "module"
            }
        ]
    },
    "transfer_mode": 2,
    "download_speed_limit": 100,
    "upload_speed_limit": 100,
    "timeout": 1000,
    "callback_url": "https://example.com/job/callback",
    "rolling_config": {
        "type": 1,
        "execution_mode": 1,
        "mode": 1,
        "expression": "1 5 10 100%"
    },
    "start_task": true
}
```

