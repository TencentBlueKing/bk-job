{
  "system_id": "bk_job",
  "system": {
    "id": "bk_job",
    "name": "作业平台",
    "description": "蓝鲸作业平台（BlueKing Job）是一套基于蓝鲸管控平台 Agent 管道之上，提供基础操作的原子平台；具备上万台并发处理能力，除了支持脚本执行、文件拉取 / 分发、定时任务等一系列基础运维场景以外，还支持通过流程调度能力将零碎的单个任务组装成一个自动化作业流程；而每个任务都可做为一个原子节点，提供给上层或周边系统/平台使用，实现跨系统调度自动化。",
    "clients": ["{{APP_CODE}}"],
    "managers": ["{{MANAGERS}}"],
    "callback_url": "{{JOB_HOST}}/iamv4/api/v1/callback"
  },
  "resource_types": [
    {"id": "biz", "name": "业务"},
    {"id": "biz_set", "name": "业务集"},
    {"id": "tenant_set", "name": "租户集", "_comment": "多租户才有"},
    {"id": "biz_dynamic_group", "name": "业务（动态分组视图）"},
    {"id": "biz_container", "name": "业务（容器视图）"},

    {"id": "set", "name": "集群", "ancestors": ["biz"]},
    {"id": "module", "name": "模块", "ancestors": ["biz", "set"]},
    {"id": "dynamic_group", "name": "动态分组", "ancestors": ["biz_dynamic_group"]},
    {"id": "host", "name": "主机", "ancestors": ["biz"]},

    {"id": "cluster", "name": "容器集群", "ancestors": ["biz_container"]},
    {"id": "namespace", "name": "命名空间", "ancestors": ["biz_container", "cluster"]},

    {"id": "script", "name": "脚本", "ancestors": ["biz"]},
    {"id": "job_template", "name": "作业模板", "ancestors": ["biz"]},
    {"id": "job_plan", "name": "作业执行方案", "ancestors": ["biz", "job_template"]},
    {"id": "cron", "name": "定时任务", "ancestors": ["biz"]},
    {"id": "account", "name": "执行账号", "ancestors": ["biz"]},
    {"id": "tag", "name": "标签", "ancestors": ["biz"]},
    {"id": "file_source", "name": "文件源", "ancestors": ["biz"]},
    {"id": "ticket", "name": "凭证", "ancestors": ["biz"]},

    {"id": "public_script", "name": "公共脚本"}
